#!/usr/bin/env python3
"""Convenience entry point -- runs the setup CLI without requiring
`pip install -e .` first. Equivalent to `macropad-setup` once installed.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from macropad.setup_cli import main

if __name__ == "__main__":
    main()
