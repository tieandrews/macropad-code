#!/usr/bin/env python3
"""Convenience entry point -- runs the bridge daemon without requiring
`pip install -e .` first. Equivalent to `macropad-bridge` once installed.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from macropad.bridge import main

if __name__ == "__main__":
    main()
