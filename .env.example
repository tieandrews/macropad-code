# Copy to `.env` in the repo root and fill in the keys for your chosen
# voice.backend in config/bridge.yaml. The bridge loads this automatically
# on startup (via python-dotenv) if the file exists.
#
# Only set the keys you actually use -- unused keys are ignored.

# OpenAI -- openai_whisper, openai_gpt4o_mini, openai_realtime
OPENAI_API_KEY=

# Together AI -- together_whisper, together_realtime
TOGETHER_API_KEY=
